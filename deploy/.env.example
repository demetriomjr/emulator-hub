# Existing external Redis/database endpoint. Do not commit deploy/.env.
REDIS_URL=redis://redis.example.internal:6379
REDIS_NAMESPACE=emulator-hub:v1
CADDY_NETWORK=caddy
REDIS_NETWORK=platform-data
EMULATOR_HUB_DATA_VOLUME=emulator-hub-data
# Optional: exactly nine distinct HTTPS ports published by Caddy for player iframes.
# Leave empty to serve players on the Hub origin.
PLAYER_ORIGIN_PORTS=
# Required for POST /api/ops/backups/backend-state and startup backup authorization.
EMULATOR_HUB_BACKUP_TOKEN=replace-with-a-long-random-secret
